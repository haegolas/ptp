:root {
}
/* 1. 인벤토리 전체 배경 패널 */
.inventory-panel {
    position: absolute;
    align-self: center;
    width: 380px;
    height: 520px;
    margin: 20px;
    padding: 15px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(0, 255, 253);
    border-width: 2px;
    border-radius: 8px;
}
/* 2. 타이틀 (대소문자 둘 다 작동하도록 처리) */
.Inventory-title, .inventory-title {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 10px;
}
/* 3. 슬롯들이 배치되는 민트색 그리드 (4칸 x 3줄 = 270px) */
.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    height: 270px;
    padding: 6px;
    background-color: rgb(170, 255, 230);
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: 8px;
}
/* 4. 흰색 네모 아이템 슬롯 (사라졌던 스타일 복구!) */
.inventory-slot {
    position: relative;
    width: 75px;
    height: 80px;
    margin: 2px;
    background-color: rgb(255, 255, 255);
    border-color: rgb(0, 0, 0);
    border-width: 1px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}
/* 슬롯 마우스 호버 시 노란 테두리 */
.inventory-slot:hover {
    background-color: rgb(128, 128, 128);
    border-color: rgb(255, 235, 4);
}
/* 5. 슬롯 내부 아이콘 이미지 (사라졌던 이미지 크기 64x64 복구!) */
.slot-icon {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
/* 6. 아이템 수량 표시 검은색 뱃지 */
.slot-label {
    position: absolute;
    right: 2px;
    bottom: 2px;
    min-width: 18px;
    height: 16px;
    padding-left: 3px;
    padding-right: 3px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
/* 7. 하단 아이템 정보창 */
.info-box {
    margin-top: 10px;
    min-height: 120px;
    padding: 10px;
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: 8px;
}
.info-text {
    color: rgb(255, 255, 255);
    font-size: 16px;
    padding-left: 5px;
    white-space: normal;
}